@model IEnumerable<PhezuluManagementSystem.Controllers.StaffListItem>

@{
    ViewData["Title"] = "Staff Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Staff Management</h1>
            <p class="text-muted">
                Manage staff accounts and their system roles.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Add Staff Member
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Email Address</th>
                    <th>Assigned Role(s)</th>
                    <th>Account Type</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>@staff.Email</td>
                        <td>@staff.Roles</td>
                        <td>
                            @if (staff.IsOwner)
                            {
                                <span class="badge bg-success">Owner</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Staff</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>